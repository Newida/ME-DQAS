% color palette
\definecolor{aqua}{RGB}{0, 158, 227} % main colors
\definecolor{skyblue}{RGB}{89, 189, 247}
\definecolor{fuchsia}{RGB}{232, 46, 130}
\definecolor{freshviolet}{RGB}{152, 48, 130}
\definecolor{softgray}{RGB}{112, 111, 111} % accent colors
\definecolor{sunshine}{RGB}{255, 188, 41}
\definecolor{indianred}{RGB}{236, 100, 105}
\definecolor{carribean}{RGB}{63, 187, 171}
\definecolor{cornflower}{RGB}{74, 74, 216}
\definecolor{navy}{RGB}{12, 18, 43} % background colors
\definecolor{crisp}{RGB}{255, 255, 255}
\colorlet{color01}{aqua} % aliases for plots
\colorlet{color02}{freshviolet}
\colorlet{color03}{carribean}
\colorlet{color04}{sunshine}
\colorlet{color05}{fuchsia}
