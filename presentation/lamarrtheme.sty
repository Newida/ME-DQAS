% beamer theme
\usetheme{metropolis}
\setbeamersize{text margin left=18pt, text margin right=18pt}
\setbeamerfont{title}{size=\huge, series=\bfseries}
\setbeamerfont{author}{size=\large, series=\bfseries}
\setbeamerfont{date}{size=\normalsize}
\setbeamerfont{frametitle}{size=\Large, series=\bfseries}
\setbeamercolor{normal text}{fg=black,bg=crisp}
\setbeamercolor{title}{fg=white}
\setbeamercolor{author}{fg=crisp}
\setbeamercolor{date}{fg=crisp}
\setbeamercolor{frametitle}{fg=black,bg=crisp}
\setbeamercolor{author in head/foot}{fg=black,bg=crisp}
\setbeamercolor{progress bar in section page}{fg=aqua,bg=fuchsia}
\setlength{\metropolis@progressonsectionpage@linewidth}{1.8pt}

% font
\usepackage{iftex}
\ifPDFTeX % pdflatex fallback: Helvetica instead of WorkSans
  \usepackage[scaled=0.92]{helvet}
  \renewcommand{\familydefault}{\sfdefault}
\else
\usepackage[no-math]{fontspec}
\setsansfont{WorkSans}[
  Path=fonts/,
  Extension=.ttf,
  UprightFont=*-Regular,
  BoldFont=*-SemiBold,
  ItalicFont=*-Italic,
  BoldItalicFont=*-SemiBoldItalic,
]
\fi
\usefonttheme[onlymath]{serif}

\makeatletter
\setbeamertemplate{title page}{%
  \makebox[8pt]{}%
  \begin{minipage}[b][\paperheight]{\textwidth}
    \vspace*{65pt} % height of purple triangle
    \vfill%
    \ifx\inserttitle\@empty\else\usebeamertemplate*{title}\fi
    \ifx\insertsubtitle\@empty\else\usebeamertemplate*{subtitle}\fi
    \ifx\beamer@shortauthor\@empty\else\usebeamertemplate*{author}\fi
    \ifx\insertdate\@empty\else\usebeamertemplate*{date}\fi
    \vfill%
    \vspace*{65pt} % height of footer
  \end{minipage}
}
\setbeamertemplate{title}{%
  \usebeamerfont{title}%
  \usebeamercolor[fg]{title}%
  \raggedright%
  \inserttitle%
  \par%
}
\usebackgroundtemplate{%
  \includegraphics[width=\paperwidth,height=\paperheight]{img/frame-background.pdf}%
}
\setbeamertemplate{frametitle}{%
  \vspace{9pt}%
  \nointerlineskip%
  \tikz\node[
    text width=\textwidth,
    inner sep=0pt,
  ]{%
    \usebeamerfont{frametitle}%
    \usebeamercolor[fg]{frametitle}%
    \metropolis@frametitlestrut@start%
    \insertframetitle%
    \nolinebreak%
    \metropolis@frametitlestrut@end%
  };
}
\setbeamerfont{page number in head/foot}{size=\footnotesize}
\setbeamertemplate{footline}{%
  \par\vspace*{-1\metropolis@frametitle@padding}
  \begin{beamercolorbox}[wd=\textwidth, sep=18pt]{footline}% footcites
    \usebeamerfont{page number in head/foot}%
    \usebeamertemplate*{frame footer}
  \end{beamercolorbox}
  \ifthenelse{\equal{\insertframenumber}{\string 0}}{}{% author, title, and slide number
    \par\vspace*{-3.333\metropolis@frametitle@padding}
    \leavevmode\hbox{%
      \begin{beamercolorbox}[wd=.33333\paperwidth,ht=2.8ex,dp=1.4ex,left]{author in head/foot}%
        \hspace{18pt}%
        \usebeamerfont{author in head/foot}\insertshortauthor
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.33334\paperwidth,ht=2.8ex,dp=1.4ex,center]{author in head/foot}%
        \usebeamerfont{author in head/foot}\insertshorttitle
      \end{beamercolorbox}%
      \begin{beamercolorbox}[wd=.33333\paperwidth,ht=2.8ex,dp=1.4ex,right]{author in head/foot}%
        \usebeamerfont{author in head/foot}\insertframenumber%
        \hspace{18pt}
      \end{beamercolorbox}%
    }%
    \vskip6pt%
  }
}
\makeatother

