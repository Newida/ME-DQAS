% title frame
\newcommand{\maketitleframe}{%
  \begin{frame}[noframenumbering]
    \noindent
    \begin{tikzpicture}[overlay, remember picture] % set the background
      \node at (current page.center)
        {\includegraphics[width=\paperwidth]{img/title-background.pdf}};
    \end{tikzpicture}
    \maketitle % title, author, date
  \end{frame}
}

% standout frame
\newcommand{\standout}[1]{%
  \begin{frame}[plain]{}
    \noindent
    \begin{tikzpicture}[overlay, remember picture] % set the background
      \node at (current page.center)
        {\includegraphics[width=\paperwidth]{img/standout-background.pdf}};
    \end{tikzpicture}
    \usebeamerfont{title}\usebeamercolor[fg]{title}%
    \vfill
    \centering
    #1\par%
    \vfill
  \end{frame}
}

% section frames
\AtBeginSection[]{\standout{\insertsectionhead}}
